{
  "name": "movare-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "artifacts/movare-localizador"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/movare-localizador",
    "build": "npm run build --workspace=@workspace/movare-localizador",
    "serve": "npm run serve --workspace=@workspace/movare-localizador",
    "test": "npx vitest run --dir artifacts/movare-localizador",
    "lint": "npm run typecheck --workspace=@workspace/movare-localizador"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  }
}
